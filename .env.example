# 复制为项目根目录 .env，并填写模型服务配置。
LLM_MODE=api
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-3.5-turbo

# 本地 Embedding 与 Reranker；CPU 可直接使用，GPU 用户可改为 cuda。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# 可选：自定义知识库路径。Docker 默认挂载 dataset，不需要填写。
# RAW_PDF_DIR=dataset/raw_pdf
# VECTOR_STORE_DIR=dataset/vector_store

# 首次模型下载或 CPU 精排较慢时可增大超时。
LLM_CALL_TIMEOUT_SECONDS=30
TOOL_CALL_TIMEOUT_SECONDS=120
